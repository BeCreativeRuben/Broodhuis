# ---------------------------------------------------------------------------
# Bakkerij 't Broodhuis — webshop configuratie
# Kopieer dit bestand naar `.env` en vul aan waar nodig.
# Alles heeft een werkende standaardwaarde: zonder .env start de webshop ook,
# met SQLite en de betaal-sandbox.
# ---------------------------------------------------------------------------

# Database -------------------------------------------------------------------
# Postgres. Op Vercel vult de Neon-koppeling (neon-broodhuis) dit al in als
# STORAGE_DATABASE_URL — die hoef je niet te kopiëren. De webshop neemt de
# eerste postgresql://-URL uit STORAGE_DATABASE_URL, STORAGE_POSTGRES_URL,
# POSTGRES_URL of DATABASE_URL. Een file:-pad (oud SQLite) wordt genegeerd.
DATABASE_URL="postgresql://user:wachtwoord@host/neondb?sslmode=require"

# Publieke URL van de webshop -----------------------------------------------
# Gebruikt voor Mollie redirect- en webhook-URL's. In productie de echte
# https-domeinnaam, bv. https://shop.bakkerij-tbroodhuis.be
NEXT_PUBLIC_SITE_URL="http://localhost:4317"

# Admin login (/admin) -------------------------------------------------------
ADMIN_USER="marie"
ADMIN_PASSWORD="broodhuis"
# Willekeurige lange string; ondertekent de admin-sessiecookie.
# Genereer met: openssl rand -base64 32
ADMIN_SESSION_SECRET="verander-mij-in-productie-minstens-32-tekens"

# Betalingen -----------------------------------------------------------------
# Zolang MOLLIE_API_KEY leeg is, gebruikt de webshop de ingebouwde sandbox:
# je doorloopt de volledige flow en kiest zelf "gelukt" of "mislukt".
# Test-key van Mollie begint met test_, live-key met live_
MOLLIE_API_KEY=""
# Optioneel: beperk de betaalmethodes (komma-gescheiden Mollie method-id's).
# Leeg = alle methodes die in het Mollie-dashboard aan staan.
# Bancontact + kaart, zonder ideal:
# MOLLIE_METHODS="bancontact,creditcard"
MOLLIE_METHODS="bancontact,creditcard"
# Optioneel: aparte URL voor de webhook tijdens lokaal testen via een tunnel
# (bv. `ngrok http 4317` of `cloudflared tunnel`), want Mollie kan localhost
# niet bereiken.
# MOLLIE_WEBHOOK_BASE_URL="https://jouw-tunnel.ngrok-free.app"
