// Bakkerij 't Broodhuis — webshop datamodel
//
// Productie gebruikt Neon Postgres (Vercel-koppeling neon-broodhuis).
// Het model houdt geen enums en geen scalar lists, zodat het dezelfde vorm
// houdt als de bestaande tabellen. ProductVariant en OrderItem.variantLabel
// bestaan al in productie (taarten: één product, keuzes als varianten).
// Andere extra tabellen (medewerkers, …) blijven hier buiten.
// `prisma db push` niet tegen productie draaien.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  /// Emoji of klein icoon voor de categorienavigatie
  icon        String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([sortOrder])
}

model Product {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  /// Korte wervende beschrijving voor de webshop
  description String?
  /// Vrij tekstveld: ingrediëntenlijst zoals de bakker die opgeeft
  ingredients String?
  /// Komma-gescheiden allergeencodes, zie src/lib/allergens.ts (EU-lijst van 14)
  allergens   String  @default("")
  priceCents  Int
  /// Eenheid die naast de prijs staat, bv. "per brood", "per stuk", "per 6 stuks"
  unit        String  @default("per stuk")
  imageUrl    String?
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])

  /// false = onbeperkt beschikbaar (dagelijks gebakken), true = voorraad aftellen
  trackStock  Boolean @default(false)
  stock       Int     @default(0)

  /// Aantal dagen dat dit product vooraf besteld moet worden (bv. 14 voor een feesttaart)
  leadTimeDays Int    @default(0)

  isActive    Boolean @default(true)
  isFeatured  Boolean @default(false)
  sortOrder   Int     @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems  OrderItem[]
  variants    ProductVariant[]

  @@index([categoryId, sortOrder])
  @@index([isActive])
}

/// Keuze bij één product, zoals deeg/personen bij een taart of smaak bij thee.
/// De tabel staat al in productie. Geen migratie: dit model beschrijft haar alleen.
model ProductVariant {
  id          String  @id
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku         String? @unique
  /// Slug van het vroegere losse product, zodat oude links naar de keuze wijzen.
  sourceSlug  String? @unique
  label       String
  optionsJson String  @default("{}")
  priceCents  Int
  unit        String  @default("per stuk")
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  @@index([productId, sortOrder])
}

model Order {
  id          String @id @default(cuid())
  /// Publiek bestelnummer, bv. BH-260915-0001
  orderNumber String @unique

  /// Onvoorspelbare sleutel voor de bestelpagina van de klant. Het bestelnummer
  /// loopt op en zou anders te raden zijn, waardoor iemand andermans
  /// contactgegevens zou kunnen opvragen.
  publicToken String @unique

  /// "pending" | "paid" | "failed" | "expired" | "cancelled" | "ready" | "completed"
  status      String @default("pending")

  /// "pickup" | "delivery"
  fulfillmentType String

  /// Kalenderdatum van het gekozen moment (YYYY-MM-DD, tijdzone Europe/Brussels)
  slotDate    String
  /// Id van het tijdslot uit src/lib/shop-config.ts, bv. "delivery-thu-am"
  slotId      String
  /// Voorberekend label, bv. "donderdag 17 september, 9:00 - 12:00"
  slotLabel   String

  customerName  String
  customerEmail String
  customerPhone String

  /// Alleen bij levering
  street      String?
  houseNumber String?
  postalCode  String?
  city        String?
  deliveryNote String?

  note        String?

  subtotalCents    Int
  deliveryFeeCents Int @default(0)
  totalCents       Int

  /// "sandbox" | "mollie" | later "worldline"
  paymentProvider String?
  /// "open" | "pending" | "paid" | "failed" | "canceled" | "expired"
  paymentStatus   String  @default("open")
  paymentMethod   String?
  paidAt          DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items    OrderItem[]
  payments Payment[]

  @@index([status])
  @@index([slotDate])
  @@index([createdAt])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Blijft bewaard als het product later verwijderd wordt
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  /// Snapshot van het product op moment van bestellen
  name           String
  unit           String @default("per stuk")
  unitPriceCents Int
  quantity       Int
  lineTotalCents Int
  allergens      String @default("")
  /// Keuze die de klant maakte, bv. "Beeee Calm" of "4 personen".
  variantLabel   String?

  createdAt DateTime @default(now())

  @@index([orderId])
}

/// Audittrail per betaalpoging. Handig voor terugzoeken bij Mollie-support.
model Payment {
  id       String @id @default(cuid())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  provider          String
  providerPaymentId String @unique
  status            String @default("open")
  method            String?
  amountCents       Int
  checkoutUrl       String?
  /// Ruwe provider-respons als JSON-string, voor debugging
  rawPayload        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
}

/// Sleutel-waarde instellingen die de bakker later via de admin kan aanpassen
/// zonder deploy (bv. tijdelijke sluitingsdagen).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
